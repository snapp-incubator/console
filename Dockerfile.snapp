##################################################
#
# Snapp console image, based on upstream release-4.14 Dockerfile.
# Upstream uses registry.ci.openshift.org builder images (CI credentials
# required); these are the public equivalents.
# Optional npm registry/proxy for yarn (e.g. https://repo.snapp.tech/repository/npm-proxy).
# Empty = yarn default registry. GitHub-hosted runners cannot rely on the internal proxy.
ARG NPM_PROXY_ADDRESS=""

##################################################
#
# go backend build
FROM docker.io/library/golang:1.20 AS gobuilder
ENV CGO_ENABLED=0
RUN mkdir -p /go/src/github.com/openshift/console/
ADD . /go/src/github.com/openshift/console/
WORKDIR /go/src/github.com/openshift/console/
RUN git config --global --add safe.directory /go/src/github.com/openshift/console && \
    ./build-backend.sh

##################################################
#
# nodejs frontend build (yarn 4 is vendored in frontend/.yarn/releases)
FROM docker.io/library/node:18 AS nodebuilder
ARG NPM_PROXY_ADDRESS

# prevent download of chromedriver, geckodriver, and the cypress binary as part of module installs
ENV CHROMEDRIVER_SKIP_DOWNLOAD=true \
    GECKODRIVER_SKIP_DOWNLOAD=true \
    CYPRESS_INSTALL_BINARY=0

ADD . /opt/app-root/src
WORKDIR /opt/app-root/src/frontend

RUN if [ -n "${NPM_PROXY_ADDRESS}" ]; then export YARN_NPM_REGISTRY_SERVER="${NPM_PROXY_ADDRESS}"; fi && \
    node .yarn/releases/yarn-4.12.0.cjs install --immutable && \
    node .yarn/releases/yarn-4.12.0.cjs build

##################################################
#
# actual base image for final product
FROM registry.access.redhat.com/ubi8/ubi-minimal
RUN mkdir -p /opt/bridge/bin
COPY --from=gobuilder /go/src/github.com/openshift/console/bin/bridge /opt/bridge/bin
COPY --from=nodebuilder /opt/app-root/src/frontend/public/dist /opt/bridge/static
COPY --from=gobuilder /go/src/github.com/openshift/console/pkg/graphql/schema.graphql /pkg/graphql/schema.graphql

WORKDIR /
# doesn't require a root user.
USER 1001

CMD [ "/opt/bridge/bin/bridge", "--public-dir=/opt/bridge/static" ]

LABEL \
        io.k8s.description="This is a component of OpenShift Container Platform and provides a web console." \
        com.redhat.component="openshift-enterprise-console-container" \
        maintainer="Samuel Padgett <spadgett@redhat.com>" \
        name="openshift3/ose-console" \
        License="Apache 2.0" \
        io.k8s.display-name="OpenShift Console" \
        vendor="Red Hat" \
        io.openshift.tags="openshift,console"
